---
import { Search } from 'lucide-astro';
---

<section class="center-hero">
  <h1 class="logo">New Life</h1>
  <label class="hero-search-shell" for="hero-search">
    <Search size={18} />
    <input
      id="hero-search"
      class="hero-search-input"
      type="text"
      placeholder="Search the web privately"
      autocomplete="off"
      spellcheck="false"
    />
  </label>
</section>
